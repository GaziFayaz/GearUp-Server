{
  "name": "GearUp",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bunx --bun prisma generate && tsc",
    "start": "bun run src/index.ts",
    "test": "bun test tests/",
    "test:watch": "bun test --watch tests/",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:migrate:prod": "bunx --bun prisma migrate deploy",
    "db:seed": "bun run prisma/seeds/seed.ts",
    "db:generate": "bunx --bun prisma generate",
    "db:studio": "bunx --bun prisma studio",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check '.'"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "prettier": "3.9.4",
    "prisma": "^7.8.0",
    "tsx": "^4.23.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  }
}
